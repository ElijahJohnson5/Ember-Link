{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    // Off by default — emitted .d.ts.map files would otherwise ship to npm.
    // Re-enable per-package or via the local tsconfig if you need go-to-def
    // jumps into source for cross-package navigation while developing.
    "declarationMap": false,
    "emitDeclarationOnly": true,
    // Keep the incremental build cache inside each package's `dist/`
    // so that when a package's dist is cleaned (or moon restores its
    // cached outputs), the buildinfo lives and dies with the rest of
    // the output. `${configDir}` resolves to the directory of the
    // consuming tsconfig (TS 5.5+), not this root file.
    "tsBuildInfoFile": "${configDir}/dist/.tsbuildinfo",
    "incremental": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "strict": true,
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true
  },
  "exclude": [
    "node_modules",
    "packages/**/dist/",
    "packages/svelte/.svelte-kit/"
  ],
  "references": [
    {
      "path": "./examples/nextjs-collaborative-editor"
    },
    {
      "path": "./examples/nextjs-data-grids"
    },
    {
      "path": "./examples/react-cursors"
    },
    {
      "path": "./examples/react-tiptap"
    },
    {
      "path": "./packages/core"
    },
    {
      "path": "./packages/event-emitter"
    },
    {
      "path": "./packages/protocol"
    },
    {
      "path": "./packages/react"
    },
    {
      "path": "./packages/storage"
    },
    {
      "path": "./packages/yjs-provider"
    },
    {
      "path": "./packages/yjs-storage"
    },
    {
      "path": "packages/svelte"
    }
  ]
}

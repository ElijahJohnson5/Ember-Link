# URL of the storage API route that the Ember Link server should call for
# load/save operations. In this example the route is exposed by the Next.js app
# itself at /api/storage. Point STORAGE_ENDPOINT on the Ember Link server at it
# (e.g. http://host.docker.internal:3000/api/storage when the server runs in Docker).
STORAGE_ENDPOINT=http://localhost:3000/api/storage

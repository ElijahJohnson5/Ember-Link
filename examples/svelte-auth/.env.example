# Private RSA key used to sign JWTs (PKCS8 PEM).
# Generate with: openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
# Paste the full PEM (BEGIN/END lines included) on a single line, replacing newlines with \n,
# or use a multi-line value if your runner supports it.
JWT_SECRET_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Public counterpart of JWT_SECRET_KEY (SPKI PEM). Read at build time via $env/static/public.
# Generate with: openssl rsa -in private.pem -pubout -out public.pem
# The Ember Link server should have the same value as its JWT_SIGNER_KEY env var.
PUBLIC_JWT_SIGNER_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

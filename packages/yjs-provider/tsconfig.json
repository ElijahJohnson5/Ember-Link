{
  "extends": ["../../tsconfig.json"],
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "outDir": "dist/",
    "target": "ES2024",
    "paths": {
      "~/*": ["./src/*"],
      "@ember-link/core": ["../core/src/index.ts"],
      "@ember-link/core/*": ["../core/src/*"]
    }
  },
  "include": ["./src/**/*", "../core/**/*"],
  "exclude": [
    "dist/",
    "../core/vitest.config.ts",
    "src/__test__/**",
    "../core/src/__test__/**",
    "**/*.spec.*",
    "**/*.test.*"
  ],
  "references": [
    {
      "path": "../core"
    }
  ]
}

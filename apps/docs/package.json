		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.3",
		"uuid": "^14.0.0",
		"vite": "^8.0.12",
		"vitest": "^4.1.6",

{
	"name": "docs",
	"private": true,
	"version": "0.0.3",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@ember-link/core": "workspace:^",
		"@ember-link/svelte": "workspace:^",
		"@ember-link/yjs-provider": "workspace:^",
		"@ember-link/yjs-storage": "workspace:^",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.14.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.59.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@tiptap/core": "^3.23.4",
		"@tiptap/extension-collaboration": "^3.23.4",
		"@tiptap/extension-collaboration-caret": "^3.23.4",
		"@tiptap/pm": "^3.23.4",
		"@tiptap/starter-kit": "^3.23.4",
		"@tiptap/y-tiptap": "^3.0.3",
		"autoprefixer": "^10.5.0",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"jsdom": "^29.1.1",
		"mdsvex": "^0.12.7",
		"mode-watcher": "^1.1.0",
		"postcss": "^8.5.14",
